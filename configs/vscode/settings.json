{
  "editor.formatOnSave": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  "python.languageServer": "Pylance",
  "python.terminal.activateEnvironment": true,
  "black-formatter.args": ["--line-length=79"],
  "isort.args": ["--profile", "black", "--line-length", "79"],
  "flake8.args": ["--max-line-length=79"],
  "flake8.ignorePatterns": ["env/**", "**/__pycache__/**"],
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.py$",
        "cmd": "python \"${workspaceFolder}/commands/clean/format.py\" \"${file}\"",
        "runIn": "terminal"
      },
      {
        "match": "\\.py$",
        "cmd": "python \"/tmp/_MEIeNoEA1/PyRefine/commands/clean/format.py\" \"${file}\"",
        "runIn": "terminal"
      },
      {
        "match": "\\.py$",
        "cmd": "python \"/tmp/_MEI5LMQci/PyRefine/commands/clean/format.py\" \"${file}\"",
        "runIn": "terminal"
      }
    ]
  }
}
